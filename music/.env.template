# Host port published for Cloudflare tunnel (Immich uses 8201)
NAVIDROME_HTTP=8202

# Must match DOMAIN in the root .env (used by Traefik Host rule and ND_BASEURL)
DOMAIN=

# Folder with the music library on the host (FLAC, MP3, etc.). Bind-mounted read-only.
# Create it before the first `docker compose up` so Docker does not create an empty root-owned dir.
MUSIC_LOCATION=/storage/music

# Navidrome DB, cache and config (SQLite). Relative to this directory.
NAVIDROME_DATA=./data

# Image tag (https://hub.docker.com/r/deluan/navidrome)
NAVIDROME_VERSION=latest

# Must own MUSIC_LOCATION (read) and NAVIDROME_DATA (read/write). `id -u` / `id -g` on the host.
PUID=1000
PGID=1000
